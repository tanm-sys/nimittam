<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Required for downloading models from the internet -->
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Recommended for checking network connectivity before downloads -->
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!-- Required for haptic feedback -->
    <uses-permission android:name="android.permission.VIBRATE" />
    
    <!-- Device capability requirements -->
    <uses-feature android:name="android.hardware.opengles.version" android:required="false" />
    <uses-feature android:glEsVersion="0x00020000" android:required="false" />
    
    <!-- Queries for package visibility (Android 11+) -->
    <queries>
        <intent>
            <action android:name="android.intent.action.SEND" />
            <data android:mimeType="text/plain" />
        </intent>
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <data android:scheme="https" />
        </intent>
    </queries>

    <!-- Note: Storage permissions (WRITE_EXTERNAL_STORAGE) are NOT required -->
    <!-- DataStore and ModelManager use internal app storage (/data/data/<package>/files/) -->
    <!-- which apps can access without any special permissions -->

    <application
        android:name="${applicationName}"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:enableOnBackInvokedCallback="true"
        android:extractNativeLibs="true"
        android:label="@string/app_name"
        android:largeHeap="true"
        android:supportsRtl="true"
        android:theme="@style/Theme.Nimittam"
        android:usesCleartextTraffic="false">
        
        <activity
            android:name=".MainActivity"
            android:configChanges="orientation|screenSize|smallestScreenSize|screenLayout|keyboardHidden|keyboard|navigation"
            android:exported="true"
            android:launchMode="singleTask"
            android:theme="@style/Theme.Nimittam"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        
    </application>

</manifest>
